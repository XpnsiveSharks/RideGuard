      "updated": 1786595538018,
      "link": null,
      "locked": false,
      "text": "type StoreCategory = 'FRAME' | 'ROOM_CARD' | 'ROOM_THEME';\n\n  interface RentalOptionDto {\n    duration_days: 7 | 15 | 30;\n    price_coins: number;\n  }\n\n  interface StoreItemDto {\n    id: string;\n    name: string;\n    category: StoreCategory;\n    image_url: string;\n    rental_options: RentalOptionDto[];\n    sort_order: number;\n    is_active: boolean;\n    last_updated: Date;\n    created_at: Date;\n    updated_at: Date;\n  }\n\n  Create DTO:\n\n  interface CreateStoreItemDto {\n    name: string;\n    category: StoreCategory;\n    rental_options: RentalOptionDto[];\n    sort_order?: number;\n    is_active?: boolean;\n  }\n\n  Update DTO:\n\n  interface UpdateStoreItemDto {\n    name?: string;\n    category?: StoreCategory;\n    rental_options?: RentalOptionDto[];\n    sort_order?: number;\n    is_active?: boolean;\n  }\n",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type StoreCategory = 'FRAME' | 'ROOM_CARD' | 'ROOM_THEME';\n\n  interface RentalOptionDto {\n    duration_days: 7 | 15 | 30;\n    price_coins: number;\n  }\n\n  interface StoreItemDto {\n    id: string;\n    name: string;\n    category: StoreCategory;\n    image_url: string;\n    rental_options: RentalOptionDto[];\n    sort_order: number;\n    is_active: boolean;\n    last_updated: Date;\n    created_at: Date;\n    updated_at: Date;\n  }\n\n  Create DTO:\n\n  interface CreateStoreItemDto {\n    name: string;\n    category: StoreCategory;\n    rental_options: RentalOptionDto[];\n    sort_order?: number;\n    is_active?: boolean;\n  }\n\n  Update DTO:\n\n  interface UpdateStoreItemDto {\n    name?: string;\n    category?: StoreCategory;\n    rental_options?: RentalOptionDto[];\n    sort_order?: number;\n    is_active?: boolean;\n  }\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
