      "versionNonce": 311095421,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787134074159,
      "link": null,
      "locked": false,
      "text": "\n    devices\n    {\n        id: string;\n        deviceType: DeviceType;\n        serialNumber: string;\n        status?: DeviceStatus;\n        isProvisioned: boolean;\n        provisionedAt?: Date;\n        assignedUserId?: string;\n        createdAt: Date;\n        updatedAt: Date;\n    }\n\n    type DeviceType = 'camera' | 'metal_detector';\n\n    type DeviceStatus =\n      | 'provisioned'\n      | 'disabled';",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "855p2Lv-ps7oHUu0pS-33",
      "originalText": "\n    devices\n    {\n        id: string;\n        deviceType: DeviceType;\n        serialNumber: string;\n        status?: DeviceStatus;\n        isProvisioned: boolean;\n        provisionedAt?: Date;\n        assignedUserId?: string;\n        createdAt: Date;\n        updatedAt: Date;\n    }\n\n    type DeviceType = 'camera' | 'metal_detector';\n\n    type DeviceStatus =\n      | 'provisioned'\n      | 'disabled';",
      "autoResize": true,
      "lineHeight": 1.25
    },
