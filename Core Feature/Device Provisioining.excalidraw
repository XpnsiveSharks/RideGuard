      "text": "\n    devices\n    {\n        id: string;\n        deviceType: DeviceType;\n        serialNumber: string;\n        status?: DeviceStatus;\n        isProvisioned: boolean;\n        provisionedAt?: Date;\n        assignedUserId?: string;\n        createdAt: Date;\n        updatedAt: Date;\n    }\n\n    type DeviceType = 'camera' | 'metal_detector';\n\n    type DeviceStatus =\n      | 'provisioned'\n      | 'disabled';",
